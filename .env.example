DATABASE_PATH=tickets.db
DUPLICATE_THRESHOLD=0.9
LLM_TIMEOUT_SECONDS=10.0
HOST=0.0.0.0
PORT=8000
UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
CELERY_BROKER_URL=rediss://default:your_upstash_redis_token@your-upstash-database.upstash.io:6379/0
CELERY_RESULT_BACKEND=rediss://default:your_upstash_redis_token@your-upstash-database.upstash.io:6379/0

LLM_PROVIDER=gemini
LLM_PROVIDER_API_KEY=your_gemini_or_provider_api_key_here
LLM_MODEL_NAME=gemini-3.8-flash
LLM_EMBEDDING_MODEL_NAME=gemini-embedding-001
